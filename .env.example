# Fiuu Merchant Credentials
# Get these from https://portal.fiuu.com/

FIUU_MERCHANT_ID=your_merchant_id
FIUU_VERIFICATION_KEY=your_verification_key
FIUU_SECRET_KEY=your_secret_key
FIUU_USERNAME=your_username
FIUU_PASSWORD=your_password
FIUU_APP_NAME=YourAppName

# Environment
FIUU_SANDBOX_MODE=true

# Supabase - receives the Fiuu payment webhook and records payments.
# Publishable key only; it is safe in the app. The merchant SECRET key must
# live as a Supabase function secret, never here.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
